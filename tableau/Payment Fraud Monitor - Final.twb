    <worksheet name='Customer Baseline Outliers'>
      <table>
        <view>
          <datasources>
            <datasource caption='Enriched PaySim' name='federated.0ppg5qw1h7z1tq1aevvkp1fqv7ql' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Std Dev Threshold' datatype='real' name='[Parameter 2588708551618572]' param-domain-type='range' role='measure' type='quantitative' value='4.0'>
              <calculation class='tableau' formula='4.0' />
              <range granularity='0.5' max='5.0' min='0.5' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ppg5qw1h7z1tq1aevvkp1fqv7ql'>
            <column caption='Customer Avg (LOD)' datatype='real' name='[Calculation_2588708546224128]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [nameOrig] : AVG([amount]) }' />
            </column>
            <column caption='Customer StdDev (LOD)' datatype='real' name='[Calculation_2588708547350530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [nameOrig] : STDEV([amount]) }' />
            </column>
            <column caption='Deviation Score (Live)' datatype='real' name='[Calculation_2588708547911683]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([amount] - [Calculation_2588708546224128]) / [Calculation_2588708547350530]' />
            </column>
            <column caption='Customer Baseline Outlier' datatype='boolean' name='[Calculation_ProjectOutlier]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_2588708547350530]) OR [Calculation_2588708547350530] = 0 THEN FALSE ELSE ABS([Calculation_2588708547911683]) &gt;= [Parameters].[Parameter 2588708551618572] END' />
            </column>
            <column caption='Has Repeated Customer History' datatype='boolean' name='[Calculation_ProjectUsableBaseline]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT ISNULL([Calculation_2588708547350530]) AND [Calculation_2588708547350530] &gt; 0' />
            </column>
            <column caption='Amount' datatype='real' name='[amount]' role='measure' type='quantitative' />
            <column-instance column='[nameOrig]' derivation='Attribute' name='[attr:nameOrig:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2588708546224128]' derivation='Avg' name='[avg:Calculation_2588708546224128:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2588708547350530]' derivation='Avg' name='[avg:Calculation_2588708547350530:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2588708547911683]' derivation='Avg' name='[avg:Calculation_2588708547911683:qk]' pivot='key' type='quantitative' />
            <column-instance column='[amount]' derivation='Avg' name='[avg:amount:qk]' pivot='key' type='quantitative' />
            <column-instance column='[risk_score]' derivation='Max' name='[max:risk_score:qk]' pivot='key' type='quantitative' />
            <column caption='Name Orig' datatype='string' name='[nameOrig]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_ProjectOutlier]' derivation='None' name='[none:Calculation_ProjectOutlier:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_ProjectUsableBaseline]' derivation='None' name='[none:Calculation_ProjectUsableBaseline:nk]' pivot='key' type='nominal' />
            <column-instance column='[transaction_id]' derivation='None' name='[none:transaction_id:nk]' pivot='key' type='nominal' />
            <column caption='Risk Score' datatype='integer' name='[risk_score]' role='measure' type='quantitative' />
            <column caption='Transaction Id' datatype='string' name='[transaction_id]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0ppg5qw1h7z1tq1aevvkp1fqv7ql].[none:Calculation_ProjectUsableBaseline:nk]'>
            <groupfilter function='member' level='[none:Calculation_ProjectUsableBaseline:nk]' member='true' />
