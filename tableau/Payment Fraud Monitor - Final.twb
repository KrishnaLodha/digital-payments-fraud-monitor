    <worksheet name='Scenario Net Saving KPI'>
      <table>
        <view>
          <datasources>
            <datasource caption='Enriched PaySim' name='federated.0ppg5qw1h7z1tq1aevvkp1fqv7ql' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Risk Threshold' datatype='real' name='[Parameter 2588708551090187]' param-domain-type='range' role='measure' type='quantitative' value='70.0'>
              <calculation class='tableau' formula='70.0' />
              <range granularity='1.0' max='100.0' min='0.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ppg5qw1h7z1tq1aevvkp1fqv7ql'>
            <column caption='Flagged Transactions' datatype='integer' default-format='#,##0' name='[Calculation_4785056194863104]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [risk_score] &gt;= [Parameters].[Parameter 2588708551090187]&#10;THEN 1&#10;ELSE 0&#10;END' />
            </column>
            <column caption='False Positive Count' datatype='integer' default-format='#,##0' name='[Calculation_4785056195031042]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;    IF [risk_score] &gt;= [Parameters].[Parameter 2588708551090187]&#10;       AND [isFraud] = 0&#10;    THEN 1&#10;    ELSE 0&#10;    END&#10;)' />
            </column>
            <column caption='Friction Cost (USD)' datatype='integer' default-format='&quot;$&quot;#,##0' name='[Calculation_PolishFrictionCost]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='15 * [Calculation_4785056195031042]' />
            </column>
            <column caption='Review Cost (USD)' datatype='integer' default-format='&quot;$&quot;#,##0' name='[Calculation_PolishReviewCost]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='25 * SUM([Calculation_4785056194863104])' />
            </column>
            <column caption='Fraud Value Captured (amount units)' datatype='real' default-format='#,##0,,.0&quot;M&quot;' name='[Calculation_ProjectCapturedAmount]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [isFraud] = 1 AND [risk_score] &gt;= [Parameters].[Parameter 2588708551090187] THEN [amount] ELSE 0 END)' />
            </column>
            <column caption='Scenario Fraud Value Captured (USD)' datatype='real' default-format='&quot;$&quot;#,##0' name='[Calculation_ProjectCapturedUSD]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_ProjectCapturedAmount] * 0.001' />
            </column>
            <column caption='Scenario Net Saving (USD)' datatype='real' default-format='&quot;$&quot;#,##0' name='[Calculation_ProjectNetSaving]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_ProjectCapturedUSD] - [Calculation_PolishReviewCost] - [Calculation_PolishFrictionCost]' />
            </column>
            <column caption='DisplayNet' datatype='string' name='[DisplayNet]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ABS([Calculation_ProjectNetSaving]) &gt;= 1000000 THEN &apos;$&apos; + STR(ROUND([Calculation_ProjectNetSaving]/1000000,2)) + &apos;M&apos; ELSE &apos;$&apos; + STR(ROUND([Calculation_ProjectNetSaving]/1000,1)) + &apos;K&apos; END' />
            </column>
            <column caption='Amount' datatype='real' name='[amount]' role='measure' type='quantitative' />
            <column caption='Is Fraud' datatype='integer' name='[isFraud]' role='measure' type='quantitative' />
            <column caption='Risk Score' datatype='integer' name='[risk_score]' role='measure' type='quantitative' />
            <column-instance column='[DisplayNet]' derivation='User' name='[usr:DisplayNet:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='color' value='#5B6B7E' />
            <format attr='font-size' value='9' />
          </style-rule>
          <style-rule element='cell'>
            <format attr='background-color' value='#FFFFFF' />
            <format attr='font-family' value='Tableau Book' />
            <format attr='font-size' value='10' />
            <format attr='color' value='#5B6B7E' />
            <format attr='text-align' value='center' />
            <format attr='vertical-align' value='center' />
          </style-rule>
          <style-rule element='header'>
            <format attr='background-color' value='#FFFFFF' />
            <format attr='font-family' value='Tableau Book' />
            <format attr='font-size' value='9' />
            <format attr='color' value='#5B6B7E' />
          </style-rule>
          <style-rule element='pane'>
            <format attr='background-color' value='#FFFFFF' />
            <format attr='color' value='#5B6B7E' />
          </style-rule>
          <style-rule element='worksheet'>
            <format attr='background-color' value='#FFFFFF' />
            <format attr='font-family' value='Tableau Book' />
            <format attr='font-size' value='10' />
            <format attr='color' value='#5B6B7E' />
          </style-rule>
          <style-rule element='gridline'>
            <format attr='line-visibility' value='off' />
          </style-rule>
          <style-rule element='zeroline'>
            <format attr='line-visibility' value='off' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <text column='[federated.0ppg5qw1h7z1tq1aevvkp1fqv7ql].[usr:DisplayNet:nk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='font-family' value='Tableau Semibold' />
                <format attr='font-size' value='23' />
                <format attr='font-weight' value='bold' />
                <format attr='color' value='#009681' />
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='false' />
                <format attr='text-align' value='center' />
                <format attr='vertical-align' value='center' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
