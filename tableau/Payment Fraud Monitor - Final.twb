            <column caption='Transaction Id' datatype='string' name='[transaction_id]' role='dimension' type='nominal' />
            <column caption='Type' datatype='string' name='[type]' role='dimension' type='nominal' />
            <column-instance column='[SubmissionCaseSummary]' derivation='User' name='[usr:SubmissionCaseSummary:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
