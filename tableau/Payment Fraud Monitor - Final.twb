    <worksheet name='Estimated Cost'>
      <table>
        <view>
          <datasources>
            <datasource caption='Enriched PaySim' name='federated.0ppg5qw1h7z1tq1aevvkp1fqv7ql' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Risk Threshold' datatype='real' name='[Parameter 2588708551090187]' param-domain-type='range' role='measure' type='quantitative' value='70.0'>
              <calculation class='tableau' formula='70.0' />
              <range granularity='1.0' max='100.0' min='0.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ppg5qw1h7z1tq1aevvkp1fqv7ql'>
            <column caption='Flagged Transactions' datatype='integer' default-format='#,##0' name='[Calculation_4785056194863104]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [risk_score] &gt;= [Parameters].[Parameter 2588708551090187]&#10;THEN 1&#10;ELSE 0&#10;END' />
            </column>
            <column caption='False Positive Count' datatype='integer' default-format='#,##0' name='[Calculation_4785056195031042]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;    IF [risk_score] &gt;= [Parameters].[Parameter 2588708551090187]&#10;       AND [isFraud] = 0&#10;    THEN 1&#10;    ELSE 0&#10;    END&#10;)' />
            </column>
            <column caption='Missed Fraud' datatype='integer' default-format='#,##0' name='[Calculation_4785056195088387]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [risk_score] &lt; [Parameters].[Parameter 2588708551090187]&#10;AND [isFraud] = 1&#10;THEN 1&#10;ELSE 0&#10;END' />
            </column>
            <column caption='Friction Cost (USD)' datatype='integer' default-format='&quot;$&quot;#,##0' name='[Calculation_PolishFrictionCost]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='15 * [Calculation_4785056195031042]' />
            </column>
            <column caption='Missed Fraud Cost (USD)' datatype='integer' default-format='&quot;$&quot;#,##0' name='[Calculation_PolishMissedCost]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='500 * SUM([Calculation_4785056195088387])' />
            </column>
            <column caption='Review Cost (USD)' datatype='integer' default-format='&quot;$&quot;#,##0' name='[Calculation_PolishReviewCost]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='25 * SUM([Calculation_4785056194863104])' />
            </column>
            <column caption='Estimated Cost (USD)' datatype='integer' default-format='&quot;$&quot;#,##0' name='[Calculation_PolishTotalCost]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_PolishReviewCost] + [Calculation_PolishFrictionCost] + [Calculation_PolishMissedCost]' />
            </column>
            <column caption='Is Fraud' datatype='integer' name='[isFraud]' role='measure' type='quantitative' />
            <column caption='Risk Score' datatype='integer' name='[risk_score]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_PolishTotalCost]' derivation='User' name='[usr:Calculation_PolishTotalCost:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='color' value='#5B6B7E' />
            <format attr='font-size' value='9' />
          </style-rule>
          <style-rule element='cell'>
            <format attr='background-color' value='#FFFFFF' />
            <format attr='font-family' value='Tableau Book' />
