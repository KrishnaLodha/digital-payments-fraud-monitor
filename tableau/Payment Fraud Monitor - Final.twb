    <worksheet name='Fraud Rate (bps) KPI'>
      <table>
        <view>
          <datasources>
            <datasource caption='Enriched PaySim' name='federated.0ppg5qw1h7z1tq1aevvkp1fqv7ql' />
          </datasources>
          <datasource-dependencies datasource='federated.0ppg5qw1h7z1tq1aevvkp1fqv7ql'>
            <column caption='Fraud Rate (bps)' datatype='real' default-format='0.0&quot; bps&quot;' name='[Calculation_ProjectFraudBps]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNT([transaction_id]) = 0 THEN 0 ELSE 10000.0 * SUM([isFraud]) / COUNT([transaction_id]) END' />
            </column>
            <column caption='Fraud Risk Band' datatype='string' name='[Calculation_ProjectRiskBand]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_ProjectFraudBps] &gt;= 20 THEN &quot;Red&quot; ELSEIF [Calculation_ProjectFraudBps] &gt;= 10 THEN &quot;Amber&quot; ELSE &quot;Green&quot; END' />
            </column>
            <column caption='Is Fraud' datatype='integer' name='[isFraud]' role='measure' type='quantitative' />
            <column caption='Transaction Id' datatype='string' name='[transaction_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_ProjectFraudBps]' derivation='User' name='[usr:Calculation_ProjectFraudBps:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_ProjectRiskBand]' derivation='User' name='[usr:Calculation_ProjectRiskBand:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
