    <worksheet name='Fraud Time Heat Map'>
      <table>
        <view>
          <datasources>
            <datasource caption='Enriched PaySim' name='federated.0ppg5qw1h7z1tq1aevvkp1fqv7ql' />
          </datasources>
          <datasource-dependencies datasource='federated.0ppg5qw1h7z1tq1aevvkp1fqv7ql'>
            <column caption='Day and Hour Key' datatype='string' name='[Calculation_ProjectDayHour]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_ProjectWeekday] + &quot; | &quot; + [Calculation_ProjectHour]' />
            </column>
            <column caption='Confirmed Fraud Transactions' datatype='integer' default-format='#,##0' name='[Calculation_ProjectFraudCount]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([isFraud])' />
            </column>
            <column caption='Hour (00–23)' datatype='string' name='[Calculation_ProjectHour]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [hour_of_day] &lt; 10 THEN &quot;0&quot; + STR([hour_of_day]) ELSE STR([hour_of_day]) END' />
            </column>
            <column caption='Weekday' datatype='string' name='[Calculation_ProjectWeekday]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [day_of_week] WHEN &quot;Monday&quot; THEN &quot;1 Mon&quot; WHEN &quot;Tuesday&quot; THEN &quot;2 Tue&quot; WHEN &quot;Wednesday&quot; THEN &quot;3 Wed&quot; WHEN &quot;Thursday&quot; THEN &quot;4 Thu&quot; WHEN &quot;Friday&quot; THEN &quot;5 Fri&quot; WHEN &quot;Saturday&quot; THEN &quot;6 Sat&quot; WHEN &quot;Sunday&quot; THEN &quot;7 Sun&quot; END' />
            </column>
            <column caption='Day Of Week' datatype='string' name='[day_of_week]' role='dimension' type='nominal' />
            <column caption='Hour Of Day' datatype='integer' name='[hour_of_day]' role='dimension' type='quantitative' />
            <column caption='Is Fraud' datatype='integer' name='[isFraud]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_ProjectDayHour]' derivation='None' name='[none:Calculation_ProjectDayHour:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_ProjectHour]' derivation='None' name='[none:Calculation_ProjectHour:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_ProjectWeekday]' derivation='None' name='[none:Calculation_ProjectWeekday:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_ProjectFraudCount]' derivation='User' name='[usr:Calculation_ProjectFraudCount:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='background-color' value='#FFFFFF' />
            <format attr='color' value='#19283A' />
            <format attr='font-size' value='10' />
          </style-rule>
          <style-rule element='header'>
            <format attr='background-color' value='#FFFFFF' />
            <format attr='color' value='#19283A' />
            <format attr='font-size' value='10' />
          </style-rule>
          <style-rule element='mark'>
            <encoding attr='color' field='[federated.0ppg5qw1h7z1tq1aevvkp1fqv7ql].[usr:Calculation_ProjectFraudCount:qk]' palette='red_10_0' type='interpolated' />
          </style-rule>
          <style-rule element='pane'>
            <format attr='background-color' value='#FFFFFF' />
            <format attr='color' value='#5B6B7E' />
          </style-rule>
          <style-rule element='worksheet'>
            <format attr='background-color' value='#FFFFFF' />
            <format attr='color' value='#5B6B7E' />
          </style-rule>
          <style-rule element='gridline'>
            <format attr='line-visibility' value='off' />
          </style-rule>
          <style-rule element='zeroline'>
            <format attr='line-visibility' value='off' />
          </style-rule>
