            <column caption='Newbalance Orig' datatype='real' name='[newbalanceOrig]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_ProjectQueue]' derivation='None' name='[none:Calculation_ProjectQueue:nk]' pivot='key' type='nominal' />
            <column-instance column='[SubmissionCaseID]' derivation='None' name='[none:SubmissionCaseID:nk]' pivot='key' type='nominal' />
            <column-instance column='[SubmissionTime]' derivation='None' name='[none:SubmissionTime:nk]' pivot='key' type='nominal' />
            <column-instance column='[city]' derivation='None' name='[none:city:nk]' pivot='key' type='nominal' />
            <column-instance column='[device_id]' derivation='None' name='[none:device_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[transaction_id]' derivation='None' name='[none:transaction_id:nk]' pivot='key' type='nominal' />
