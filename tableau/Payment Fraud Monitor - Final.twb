              <flipboard active-id='1' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='1 · The problem — 100,000 synthetic payments; 129 known fraud cases (12.9 bps) and 152.47M amount units at risk.' captured-sheet='Live Payment Health' id='1'>
                    <capturedDeltas>
                      <datasource name='Parameters'>
                        <column name='[Parameter 2588708551090187]' value='70.0' />
                      </datasource>
                    </capturedDeltas>
                  </story-point>
                  <story-point caption='2 · Patterns — At 05:00, 10 fraud among 32 payments (31.3%). Fraud is 63 TRANSFER + 66 CASH_OUT. Delhi has 49 cases; Kolkata 41; five fraud cases lack map coordinates.' captured-sheet='Fraud Pattern Explorer' id='2'>
                    <capturedDeltas>
                      <datasource name='Parameters'>
                        <column name='[Parameter 2588708551090187]' value='70.0' />
                      </datasource>
                    </capturedDeltas>
                  </story-point>
                  <story-point caption='3 · Trade-off at 70 — 347 alerts, 103 fraud cases captured, 244 false positives, 26 missed. Captured fraud amount: 145.29M units; scenario net saving: $132,953.' captured-sheet='Threshold &amp; Cost Simulator' id='3'>
                    <capturedDeltas>
                      <datasource name='Parameters'>
                        <column name='[Parameter 2588708551090187]' value='70.0' />
                      </datasource>
                    </capturedDeltas>
                  </story-point>
                  <story-point caption='4 · Recommendation — Cutoff 76 maximizes scenario net saving ($138,196): 198 alerts, 97 detected fraud cases, 101 false positives and 32 missed. Synthetic data and explicit cost assumptions limit this result.' captured-sheet='Threshold &amp; Cost Simulator' id='4'>
                    <capturedDeltas>
                      <datasource name='Parameters'>
                        <column name='[Parameter 2588708551090187]' value='76.0' />
                      </datasource>
                    </capturedDeltas>
                  </story-point>
                </story-points>
              </flipboard>
