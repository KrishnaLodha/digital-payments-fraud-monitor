    <worksheet name='Device Velocity'>
      <table>
        <view>
          <datasources>
            <datasource caption='Device Velocity' name='federated.velocity' />
          </datasources>
          <datasource-dependencies datasource='federated.velocity'>
            <column caption='7d count' datatype='integer' default-format='#,##0' name='[SubmissionRolling7]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_SUM(SUM([transaction_count]), -6, 0)'>
                <table-calc ordering-type='Columns' />
              </calculation>
            </column>
            <column caption='January day' datatype='integer' name='[day_number]' role='measure' type='quantitative' />
            <column caption='Sampled device' datatype='string' name='[device_id]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;DEV_RING_3839&quot;' value='Device 3839' />
                <alias key='&quot;DEV_RING_3972&quot;' value='Device 3972' />
                <alias key='&quot;DEV_RING_4816&quot;' value='Device 4816' />
              </aliases>
            </column>
            <column-instance column='[day_number]' derivation='None' name='[none:day_number:qk]' pivot='key' type='quantitative' />
            <column-instance column='[device_id]' derivation='None' name='[none:device_id:nk]' pivot='key' type='nominal' />
            <column caption='Transaction Count' datatype='integer' name='[transaction_count]' role='measure' type='quantitative' />
            <column-instance column='[SubmissionRolling7]' derivation='User' name='[usr:SubmissionRolling7:qk:1]' pivot='key' type='quantitative'>
              <table-calc ordering-field='[federated.velocity].[day_number]' ordering-type='Field' />
            </column-instance>
          </datasource-dependencies>
          <filter class='categorical' column='[federated.velocity].[none:device_id:nk]'>
            <groupfilter function='union'>
              <groupfilter function='member' level='[none:device_id:nk]' member='&quot;DEV_RING_3972&quot;' />
              <groupfilter function='member' level='[none:device_id:nk]' member='&quot;DEV_RING_4816&quot;' />
              <groupfilter function='member' level='[none:device_id:nk]' member='&quot;DEV_RING_3839&quot;' />
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.velocity].[none:device_id:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='background-color' value='#FFFFFF' />
            <format attr='color' value='#19283A' />
            <format attr='font-size' value='10' />
          </style-rule>
          <style-rule element='header'>
            <format attr='background-color' value='#FFFFFF' />
            <format attr='color' value='#19283A' />
            <format attr='font-size' value='10' />
          </style-rule>
          <style-rule element='pane'>
            <format attr='background-color' value='#FFFFFF' />
            <format attr='color' value='#5B6B7E' />
          </style-rule>
          <style-rule element='worksheet'>
            <format attr='background-color' value='#FFFFFF' />
            <format attr='color' value='#5B6B7E' />
          </style-rule>
          <style-rule element='gridline'>
            <format attr='line-visibility' value='off' />
          </style-rule>
          <style-rule element='zeroline'>
            <format attr='line-visibility' value='off' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
