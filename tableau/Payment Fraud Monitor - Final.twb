      <aliases enabled='yes' />
      <column caption='Customer Avg (LOD)' datatype='real' name='[Calculation_2588708546224128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [nameOrig] : AVG([amount]) }' />
      </column>
      <column caption='Customer StdDev (LOD)' datatype='real' name='[Calculation_2588708547350530]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [nameOrig] : STDEV([amount]) }' />
      </column>
      <column caption='Deviation Score (Live)' datatype='real' name='[Calculation_2588708547911683]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([amount] - [Calculation_2588708546224128]) / [Calculation_2588708547350530]' />
      </column>
      <column caption='Is Outlier' datatype='boolean' name='[Calculation_2588708548042756]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_2588708547350530]) OR [Calculation_2588708547350530] = 0 THEN FALSE ELSE ABS([Calculation_2588708547911683]) &gt;= [Parameters].[Parameter 2588708551618572] END' />
      </column>
      <column caption='Fraud Rate (%)' datatype='real' default-format='0.000&quot;%&quot;' name='[Calculation_2588708548292613]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([isFraud]) / COUNT([isFraud])) * 100' />
      </column>
      <column caption='Approval Proxy (Not Flagged)' datatype='real' default-format='p0.00%' name='[Calculation_2588708548472838]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF COUNT([transaction_id]) = 0 THEN 0 ELSE 1 - SUM([Calculation_4785056194863104]) / COUNT([transaction_id]) END' />
      </column>
      <column caption='Value at Risk' datatype='real' default-format='#,##0,,.0&quot;M&quot;' name='[Calculation_2588708548591623]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [isFraud] = 1 THEN [amount] END)' />
      </column>
      <column caption='Avg Ticket Size' datatype='real' default-format='#,##0.00' name='[Calculation_2588708548685832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([amount])' />
      </column>
      <column caption='Txn Count per Device' datatype='integer' name='[Calculation_2588708550852617]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [device_id] : COUNTD([transaction_id]) }' />
      </column>
      <column caption='Location Status' datatype='string' name='[Calculation_2588708550922250]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([latitude]) OR [city] = &quot;Unrecognized&quot; THEN &quot;Unrecognized Location&quot;&#10;ELSE &quot;Mapped&quot;&#10;END' />
      </column>
      <column caption='Flagged by Threshold' datatype='boolean' name='[Calculation_2588708551774221]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[risk_score] &gt;= [Parameters].[Parameter 2588708551090187]' />
      </column>
      <column caption='Fraud Rate' datatype='real' default-format='p0.000%' name='[Calculation_2588708753104912]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([isFraud]) / COUNT([transaction_id])' />
      </column>
      <column caption='Flagged Transactions' datatype='integer' default-format='#,##0' name='[Calculation_4785056194863104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [risk_score] &gt;= [Parameters].[Parameter 2588708551090187]&#10;THEN 1&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Fraud Capture Rate' datatype='real' default-format='p0.0%' name='[Calculation_4785056194969601]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_4785056195375108]) / SUM([isFraud])' />
      </column>
      <column caption='False Positive Count' datatype='integer' default-format='#,##0' name='[Calculation_4785056195031042]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [risk_score] &gt;= [Parameters].[Parameter 2588708551090187]&#10;       AND [isFraud] = 0&#10;    THEN 1&#10;    ELSE 0&#10;    END&#10;)' />
      </column>
      <column caption='Missed Fraud' datatype='integer' default-format='#,##0' name='[Calculation_4785056195088387]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [risk_score] &lt; [Parameters].[Parameter 2588708551090187]&#10;AND [isFraud] = 1&#10;THEN 1&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Fraud Detected' datatype='integer' default-format='#,##0' name='[Calculation_4785056195375108]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [risk_score] &gt;= [Parameters].[Parameter 2588708551090187]&#10;AND [isFraud] = 1&#10;THEN 1&#10;ELSE 0&#10;END' />
      </column>
      <column caption='False Positive' datatype='integer' name='[Calculation_4785056195440645]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [risk_score] &gt;= [Parameters].[Parameter 2588708551090187]&#10;AND [isFraud] = 0&#10;THEN 1&#10;ELSE 0&#10;END' />
      </column>
      <column caption='False Positive Rate' datatype='real' default-format='p0.00%' name='[Calculation_4785056195940359]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_4785056195440645]) /&#10;(COUNT([transaction_id]) - SUM([isFraud]))' />
      </column>
      <column caption='Usable Customer Baseline' datatype='boolean' name='[Calculation_BaselineAvailable]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[customer_txn_count] &gt;= 2 AND [customer_std_amount] &gt; 0' />
      </column>
      <column caption='Payments with Customer History' datatype='integer' default-format='#,##0' name='[Calculation_BaselineCount]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [customer_txn_count] &gt;= 2 AND [customer_std_amount] &gt; 0 THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Net Saving (USD millions)' datatype='real' default-format='0.00' name='[Calculation_FinalNetMillions]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_ProjectNetSaving] / 1000000.0' />
      </column>
      <column caption='Friction Cost (USD)' datatype='integer' default-format='&quot;$&quot;#,##0' name='[Calculation_PolishFrictionCost]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='15 * [Calculation_4785056195031042]' />
      </column>
      <column caption='Missed Fraud Cost (USD)' datatype='integer' default-format='&quot;$&quot;#,##0' name='[Calculation_PolishMissedCost]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='500 * SUM([Calculation_4785056195088387])' />
      </column>
      <column caption='Review Cost (USD)' datatype='integer' default-format='&quot;$&quot;#,##0' name='[Calculation_PolishReviewCost]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='25 * SUM([Calculation_4785056194863104])' />
      </column>
      <column caption='Estimated Cost (USD)' datatype='integer' default-format='&quot;$&quot;#,##0' name='[Calculation_PolishTotalCost]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_PolishReviewCost] + [Calculation_PolishFrictionCost] + [Calculation_PolishMissedCost]' />
      </column>
      <column caption='Fraud Value Captured (amount units)' datatype='real' default-format='#,##0,,.0&quot;M&quot;' name='[Calculation_ProjectCapturedAmount]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [isFraud] = 1 AND [risk_score] &gt;= [Parameters].[Parameter 2588708551090187] THEN [amount] ELSE 0 END)' />
      </column>
      <column caption='Fraud Value Captured (millions of amount units)' datatype='real' default-format='0.0&quot;M&quot;' name='[Calculation_ProjectCapturedMillions]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_ProjectCapturedAmount] / 1000000.0' />
      </column>
      <column caption='Scenario Fraud Value Captured (USD)' datatype='real' default-format='&quot;$&quot;#,##0' name='[Calculation_ProjectCapturedUSD]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_ProjectCapturedAmount] * 0.001' />
      </column>
      <column caption='Day and Hour Key' datatype='string' name='[Calculation_ProjectDayHour]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_ProjectWeekday] + &quot; | &quot; + [Calculation_ProjectHour]' />
      </column>
      <column caption='Decision Health Band' datatype='string' name='[Calculation_ProjectDecisionBand]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF COUNT([transaction_id]) = 0 THEN &quot;Red&quot; ELSEIF SUM([Calculation_4785056194863104]) / COUNT([transaction_id]) &gt;= 0.02 THEN &quot;Red&quot; ELSEIF SUM([Calculation_4785056194863104]) / COUNT([transaction_id]) &gt;= 0.01 THEN &quot;Amber&quot; ELSE &quot;Green&quot; END' />
      </column>
      <column caption='Fraud Rate (bps)' datatype='real' default-format='0.0&quot; bps&quot;' name='[Calculation_ProjectFraudBps]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF COUNT([transaction_id]) = 0 THEN 0 ELSE 10000.0 * SUM([isFraud]) / COUNT([transaction_id]) END' />
      </column>
      <column caption='Confirmed Fraud Transactions' datatype='integer' default-format='#,##0' name='[Calculation_ProjectFraudCount]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([isFraud])' />
      </column>
      <column caption='Genuine Transactions' datatype='integer' default-format='#,##0' name='[Calculation_ProjectGenuineCount]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [isFraud] = 0 THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Hour (00–23)' datatype='string' name='[Calculation_ProjectHour]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [hour_of_day] &lt; 10 THEN &quot;0&quot; + STR([hour_of_day]) ELSE STR([hour_of_day]) END' />
      </column>
      <column caption='Transactions per Observed Hour' datatype='real' default-format='#,##0.0' name='[Calculation_ProjectHourlyAvg]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([transaction_id]) / COUNTD(DATETRUNC(&apos;hour&apos;, [timestamp]))' />
      </column>
      <column caption='Scenario Net Saving (USD)' datatype='real' default-format='&quot;$&quot;#,##0' name='[Calculation_ProjectNetSaving]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_ProjectCapturedUSD] - [Calculation_PolishReviewCost] - [Calculation_PolishFrictionCost]' />
      </column>
      <column caption='Customer Baseline Outlier' datatype='boolean' name='[Calculation_ProjectOutlier]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_2588708547350530]) OR [Calculation_2588708547350530] = 0 THEN FALSE ELSE ABS([Calculation_2588708547911683]) &gt;= [Parameters].[Parameter 2588708551618572] END' />
      </column>
      <column caption='Investigator Queue Entry' datatype='boolean' name='[Calculation_ProjectQueue]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_4785056194863104] = 1 OR [isFraud] = 1' />
      </column>
      <column caption='Fraud Risk Band' datatype='string' name='[Calculation_ProjectRiskBand]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_ProjectFraudBps] &gt;= 20 THEN &quot;Red&quot; ELSEIF [Calculation_ProjectFraudBps] &gt;= 10 THEN &quot;Amber&quot; ELSE &quot;Green&quot; END' />
      </column>
      <column caption='Value at Risk (millions of amount units)' datatype='real' default-format='0.0&quot;M&quot;' name='[Calculation_ProjectRiskMillions]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2588708548591623] / 1000000.0' />
      </column>
      <column caption='Transactions (thousands)' datatype='real' default-format='0&quot;K&quot;' name='[Calculation_ProjectTransactionsK]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([transaction_id]) / 1000.0' />
      </column>
      <column caption='Unrecognized Fraud Count' datatype='integer' default-format='#,##0' name='[Calculation_ProjectUnrecognizedFraud]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [city] = &quot;Unrecognized&quot; AND [isFraud] = 1 THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Has Repeated Customer History' datatype='boolean' name='[Calculation_ProjectUsableBaseline]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT ISNULL([Calculation_2588708547350530]) AND [Calculation_2588708547350530] &gt; 0' />
      </column>
      <column caption='Device Transactions (Rolling 7 Days)' datatype='integer' default-format='#,##0' name='[Calculation_ProjectVelocity]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_SUM(COUNT([transaction_id]), -6, 0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Weekday' datatype='string' name='[Calculation_ProjectWeekday]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [day_of_week] WHEN &quot;Monday&quot; THEN &quot;1 Mon&quot; WHEN &quot;Tuesday&quot; THEN &quot;2 Tue&quot; WHEN &quot;Wednesday&quot; THEN &quot;3 Wed&quot; WHEN &quot;Thursday&quot; THEN &quot;4 Thu&quot; WHEN &quot;Friday&quot; THEN &quot;5 Fri&quot; WHEN &quot;Saturday&quot; THEN &quot;6 Sat&quot; WHEN &quot;Sunday&quot; THEN &quot;7 Sun&quot; END' />
      </column>
      <column caption='DisplayAlerts' datatype='string' name='[DisplayAlerts]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Calculation_4785056194863104]) &gt;= 10000 THEN STR(ROUND(SUM([Calculation_4785056194863104])/1000,1)) + &apos;K&apos; ELSE STR(SUM([Calculation_4785056194863104])) END' />
      </column>
      <column caption='DisplayAverage' datatype='string' name='[DisplayAverage]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND([Calculation_2588708548685832]/1000,1)) + &apos;K&apos;' />
      </column>
      <column caption='DisplayCaptured' datatype='string' name='[DisplayCaptured]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&apos;$&apos; + STR(ROUND([Calculation_ProjectCapturedUSD]/1000,1)) + &apos;K&apos;' />
      </column>
      <column caption='DisplayNet' datatype='string' name='[DisplayNet]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ABS([Calculation_ProjectNetSaving]) &gt;= 1000000 THEN &apos;$&apos; + STR(ROUND([Calculation_ProjectNetSaving]/1000000,2)) + &apos;M&apos; ELSE &apos;$&apos; + STR(ROUND([Calculation_ProjectNetSaving]/1000,1)) + &apos;K&apos; END' />
      </column>
      <column caption='DisplayRisk' datatype='string' name='[DisplayRisk]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND([Calculation_ProjectRiskMillions],1)) + &apos;M&apos;' />
      </column>
      <column caption='DisplayTransactions' datatype='string' name='[DisplayTransactions]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(INT(COUNT([transaction_id])/1000)) + &apos;K&apos;' />
      </column>
      <column caption='Case ID' datatype='string' name='[SubmissionCaseID]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT([transaction_id], 12)' />
      </column>
      <column caption='Amount | Risk' datatype='string' name='[SubmissionCaseSummary]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND(SUM([amount]),0)) + &apos;  |  &apos; + STR(MAX([risk_score]))' />
      </column>
      <column caption='Time' datatype='string' name='[SubmissionTime]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(DATE([timestamp])) + &apos; &apos; + RIGHT(&apos;0&apos; + STR(DATEPART(&apos;hour&apos;,[timestamp])),2) + &apos;:00&apos;' />
      </column>
