    <worksheet name='Investigator Detail'>
      <table>
        <view>
          <datasources>
            <datasource caption='Enriched PaySim' name='federated.0ppg5qw1h7z1tq1aevvkp1fqv7ql' />
          </datasources>
          <datasource-dependencies datasource='federated.0ppg5qw1h7z1tq1aevvkp1fqv7ql'>
            <column caption='Customer Avg (LOD)' datatype='real' name='[Calculation_2588708546224128]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [nameOrig] : AVG([amount]) }' />
            </column>
            <column caption='Customer StdDev (LOD)' datatype='real' name='[Calculation_2588708547350530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [nameOrig] : STDEV([amount]) }' />
            </column>
            <column caption='Deviation Score (Live)' datatype='real' name='[Calculation_2588708547911683]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([amount] - [Calculation_2588708546224128]) / [Calculation_2588708547350530]' />
            </column>
            <column caption='Day and Hour Key' datatype='string' name='[Calculation_ProjectDayHour]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_ProjectWeekday] + &quot; | &quot; + [Calculation_ProjectHour]' />
            </column>
            <column caption='Hour (00–23)' datatype='string' name='[Calculation_ProjectHour]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [hour_of_day] &lt; 10 THEN &quot;0&quot; + STR([hour_of_day]) ELSE STR([hour_of_day]) END' />
            </column>
            <column caption='Weekday' datatype='string' name='[Calculation_ProjectWeekday]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [day_of_week] WHEN &quot;Monday&quot; THEN &quot;1 Mon&quot; WHEN &quot;Tuesday&quot; THEN &quot;2 Tue&quot; WHEN &quot;Wednesday&quot; THEN &quot;3 Wed&quot; WHEN &quot;Thursday&quot; THEN &quot;4 Thu&quot; WHEN &quot;Friday&quot; THEN &quot;5 Fri&quot; WHEN &quot;Saturday&quot; THEN &quot;6 Sat&quot; WHEN &quot;Sunday&quot; THEN &quot;7 Sun&quot; END' />
            </column>
            <column caption='Case ID' datatype='string' name='[SubmissionCaseID]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='LEFT([transaction_id], 12)' />
            </column>
            <column caption='Amount | Risk' datatype='string' name='[SubmissionCaseSummary]' role='measure' type='nominal'>
              <calculation class='tableau' formula='STR(ROUND(SUM([amount]),0)) + &apos;  |  &apos; + STR(MAX([risk_score]))' />
            </column>
            <column caption='Time' datatype='string' name='[SubmissionTime]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATE([timestamp])) + &apos; &apos; + RIGHT(&apos;0&apos; + STR(DATEPART(&apos;hour&apos;,[timestamp])),2) + &apos;:00&apos;' />
            </column>
            <column caption='Amount' datatype='real' name='[amount]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_ProjectDayHour]' derivation='Attribute' name='[attr:Calculation_ProjectDayHour:nk]' pivot='key' type='nominal' />
            <column-instance column='[nameDest]' derivation='Attribute' name='[attr:nameDest:nk]' pivot='key' type='nominal' />
