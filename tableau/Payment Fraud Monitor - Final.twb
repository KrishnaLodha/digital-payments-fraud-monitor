    <worksheet name='Approval Rate'>
      <table>
        <view>
          <datasources>
            <datasource caption='Enriched PaySim' name='federated.0ppg5qw1h7z1tq1aevvkp1fqv7ql' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Risk Threshold' datatype='real' name='[Parameter 2588708551090187]' param-domain-type='range' role='measure' type='quantitative' value='70.0'>
              <calculation class='tableau' formula='70.0' />
              <range granularity='1.0' max='100.0' min='0.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ppg5qw1h7z1tq1aevvkp1fqv7ql'>
            <column caption='Approval Proxy (Not Flagged)' datatype='real' default-format='p0.00%' name='[Calculation_2588708548472838]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNT([transaction_id]) = 0 THEN 0 ELSE 1 - SUM([Calculation_4785056194863104]) / COUNT([transaction_id]) END' />
            </column>
            <column caption='Flagged Transactions' datatype='integer' default-format='#,##0' name='[Calculation_4785056194863104]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [risk_score] &gt;= [Parameters].[Parameter 2588708551090187]&#10;THEN 1&#10;ELSE 0&#10;END' />
            </column>
            <column caption='Decision Health Band' datatype='string' name='[Calculation_ProjectDecisionBand]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF COUNT([transaction_id]) = 0 THEN &quot;Red&quot; ELSEIF SUM([Calculation_4785056194863104]) / COUNT([transaction_id]) &gt;= 0.02 THEN &quot;Red&quot; ELSEIF SUM([Calculation_4785056194863104]) / COUNT([transaction_id]) &gt;= 0.01 THEN &quot;Amber&quot; ELSE &quot;Green&quot; END' />
            </column>
            <column caption='Risk Score' datatype='integer' name='[risk_score]' role='measure' type='quantitative' />
            <column caption='Transaction Id' datatype='string' name='[transaction_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2588708548472838]' derivation='User' name='[usr:Calculation_2588708548472838:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_ProjectDecisionBand]' derivation='User' name='[usr:Calculation_ProjectDecisionBand:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='color' value='#5B6B7E' />
            <format attr='font-size' value='9' />
          </style-rule>
          <style-rule element='cell'>
            <format attr='background-color' value='#FFFFFF' />
            <format attr='font-family' value='Tableau Book' />
            <format attr='font-size' value='10' />
            <format attr='color' value='#5B6B7E' />
            <format attr='text-align' value='center' />
            <format attr='vertical-align' value='center' />
          </style-rule>
          <style-rule element='header'>
            <format attr='background-color' value='#FFFFFF' />
            <format attr='font-family' value='Tableau Book' />
            <format attr='font-size' value='9' />
            <format attr='color' value='#5B6B7E' />
          </style-rule>
          <style-rule element='mark'>
            <encoding attr='color' field='[federated.0ppg5qw1h7z1tq1aevvkp1fqv7ql].[usr:Calculation_ProjectDecisionBand:nk]' type='palette'>
              <map to='#009681'>
                <bucket>&quot;Green&quot;</bucket>
              </map>
              <map to='#c77700'>
                <bucket>&quot;Amber&quot;</bucket>
              </map>
              <map to='#ef3b5d'>
                <bucket>&quot;Red&quot;</bucket>
              </map>
            </encoding>
          </style-rule>
          <style-rule element='pane'>
            <format attr='background-color' value='#FFFFFF' />
            <format attr='color' value='#5B6B7E' />
          </style-rule>
          <style-rule element='worksheet'>
            <format attr='background-color' value='#FFFFFF' />
            <format attr='font-family' value='Tableau Book' />
